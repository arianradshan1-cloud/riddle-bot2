# Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_bot_token_here

# Channel to enforce membership (with @)
REQUIRED_CHANNEL=@rad_protocol

# Direct invite links
CHANNEL_LINK=https://t.me/rad_protocol
SUPPORT_GROUP=https://t.me/radprotocoll

# Admin Telegram IDs (comma-separated, get from @userinfobot)
ADMIN_ID=123456789

# Optional: Port (Render provides this automatically)
PORT=3000
